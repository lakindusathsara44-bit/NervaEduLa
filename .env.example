# Copy this file to .env for local development. Cloud Run should use Secret Manager for secrets.
NERVAEDU_DATABASE=local
FIREBASE_PROJECT_ID=nervaedu
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_IMPORT_LOCAL=false
HOST=127.0.0.1

# Required protected NervaEdu account-manager bootstrap
NERVAEDU_ADMIN_PHONE=077XXXXXXXX
NERVAEDU_ADMIN_PASSWORD=replace-with-a-private-password
NERVAEDU_ADMIN_NAME=NervaEdu Account Manager

# ImageKit media storage. Keep the private key only in server-side environment secrets.
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/nsxnuxxghc
